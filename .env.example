# Reference values for repository-level local tooling. Never commit the real
# .env file or credentials. Next.js reads frontend/.env.local instead; see
# frontend/.env.example for its server-only integration variables.

# FastAPI catalogue import / recommendation database.
RELATIONAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/buybyfit

# Room visualization. Use Google Application Default Credentials locally or a
# least-privileged service account in deployment. Set a private bucket in
# production so generated room files survive service restarts.
GOOGLE_CLOUD_PROJECT=your-project-id
THREE_D_BUCKET=your-private-bucket

# Optional local override. Do not use this value for shared/production data.
# THREE_D_STORAGE_DIR=./backend/storage/rooms

# Copy to .env for values shared by local tooling. Never commit the real .env.

# Frontend
# Next.js does not read this root file -- it only auto-loads env files from
# frontend/ itself. See frontend/.env.example for the variable Next.js
# actually uses (NEXT_PUBLIC_API_BASE_URL). Kept here for reference only.
PUBLIC_API_BASE_URL=http://localhost:8000

# Backend
BACKEND_ENV=development
BACKEND_PORT=8000
RELATIONAL_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/buybyfit
VECTOR_DATABASE_URL=http://localhost:6333
THREE_D_API_BASE_URL=https://api.example.com
THREE_D_API_KEY=replace-with-local-secret
